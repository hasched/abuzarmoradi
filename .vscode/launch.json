{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Quarkus Backend (Dev Mode)",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "mainClass": "io.quarkus.runner.GeneratedMain",
      "args": "",
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "name": "Angular Frontend (Debug)",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend/src",
      "sourceMapPathOverrides": {
        "webpack:/*": "${webRoot}/*",
        "/./*": "${webRoot}/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": ["Quarkus Backend (Dev Mode)", "Angular Frontend (Debug)"]
    }
  ]
}
